FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /bin/uv

# JDK 17 (keytool dahil) + APK araçları. Sürümleri ARG ile güncelle.
ARG APKTOOL_VERSION=2.11.1
ARG JADX_VERSION=1.5.2
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless curl unzip ca-certificates binutils \
    && mkdir -p /opt/apktool /opt/jadx \
    && curl -fsSL -o /opt/apktool/apktool.jar \
       "https://github.com/iBotPeaches/Apktool/releases/download/v${APKTOOL_VERSION}/apktool_${APKTOOL_VERSION}.jar" \
    && printf '#!/bin/sh\nexec java -jar /opt/apktool/apktool.jar "$@"\n' > /usr/local/bin/apktool \
    && chmod +x /usr/local/bin/apktool \
    && curl -fsSL -o /tmp/jadx.zip \
       "https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/jadx-${JADX_VERSION}.zip" \
    && unzip -q /tmp/jadx.zip -d /opt/jadx && rm /tmp/jadx.zip \
    && ln -s /opt/jadx/bin/jadx /usr/local/bin/jadx \
    && apt-get purge -y curl unzip && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev

# Düşük yetkili kullanıcı; araçlar sadece /tmp/launchcheck altında çalışır
RUN useradd --system --uid 10002 --create-home worker
USER worker
ENV HOME=/tmp/home JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=/tmp"

CMD ["arq", "launchcheck.worker.settings.WorkerSettings"]
