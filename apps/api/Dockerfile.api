FROM python:3.12-slim AS base
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY alembic.ini ./
COPY alembic ./alembic
COPY src ./src
RUN uv sync --frozen --no-dev

# API ve worker aynı uid ile çalışır: ortak yükleme volume'unda izin sorunu olmaz
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid 10001 app \
    && mkdir -p /var/lib/launchcheck/uploads \
    && chown -R app:app /var/lib/launchcheck \
    && chmod 700 /var/lib/launchcheck/uploads
USER app

EXPOSE 8000
# Migration'lar API açılmadan önce uygulanır
CMD ["sh", "-c", "alembic upgrade head && uvicorn launchcheck.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"]
