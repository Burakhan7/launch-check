# Faz 2 (derin tarama) worker'ı: Python + Playwright Chromium + Node (Lighthouse CLI).
# Sadece `arq:deep` kuyruğunu dinler. Tarayıcı trafiği container içindeki egress proxy'den geçer.
FROM node:22-trixie-slim AS node

FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /bin/uv

# Node + Lighthouse (P4 hız modülü). Sürümü ARG ile güncelle.
ARG LIGHTHOUSE_VERSION=13.6.0
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install -g --omit=dev --no-audit --no-fund "lighthouse@${LIGHTHOUSE_VERSION}" \
    && npm cache clean --force

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra deep --no-install-project
# Chromium ve sistem bağımlılıkları (fontlar dahil). Sürüm uv.lock'taki Playwright'a bağlıdır.
# (Playwright'ın kendi Node sürücüsü libatomic1 ister.)
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 \
    && playwright install --with-deps chromium \
    && apt-get install -y --no-install-recommends fonts-noto-core fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
COPY src ./src
RUN uv sync --frozen --no-dev --extra deep

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid 10001 app \
    && mkdir -p /var/lib/launchcheck/assets \
    && chown -R app:app /var/lib/launchcheck \
    && chmod 700 /var/lib/launchcheck/assets
USER app
# Salt okunur kökte Chromium profili/önbelleği /tmp'ye (tmpfs) yazar
ENV HOME=/tmp/home XDG_CONFIG_HOME=/tmp/home/.config XDG_CACHE_HOME=/tmp/home/.cache

CMD ["arq", "launchcheck.worker.deep_settings.DeepWorkerSettings"]
