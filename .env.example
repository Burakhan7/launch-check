# Launch Check — örnek ortam değişkenleri. Kopyala: cp .env.example .env

# --- Genel ---
LC_ENV=dev                                  # dev | prod (prod'da /api/docs kapalı)
LC_PUBLIC_BASE_URL=http://localhost:3000
LC_LOG_LEVEL=INFO
DOMAIN=localhost                            # Caddy bu alan adı için otomatik HTTPS alır

# --- Postgres ---
POSTGRES_USER=launchcheck
POSTGRES_PASSWORD=launchcheck               # prod'da MUTLAKA değiştir
POSTGRES_DB=launchcheck
LC_DATABASE_URL=postgresql+asyncpg://launchcheck:launchcheck@postgres:5432/launchcheck

# --- Redis ---
LC_REDIS_URL=redis://redis:6379/0

# --- Saklama ---
LC_REPORT_RETENTION_DAYS=7

# --- Rate limit (IP başına, saatlik). IP'ler tuzlanmış hash olarak, sadece Redis'te TTL ile tutulur ---
LC_RATE_LIMIT_WEB_PER_HOUR=10
LC_RATE_LIMIT_APK_PER_HOUR=3
LC_RATE_LIMIT_IP_SALT=change-me-to-a-long-random-string

# --- Web tarama ---
LC_BOT_USER_AGENT=LaunchCheckBot/1.0 (+https://launchcheck.example/bot)

# --- APK ---
LC_MAX_APK_BYTES=157286400                  # 150 MB
LC_SCAN_TMP_DIR=/tmp/launchcheck

# Google Play minimum targetSdkVersion.
# Kaynak: https://developer.android.com/google/play/requirements/target-sdk (doğrulama: 2026-11-05)
# 31 Ağustos 2026'dan itibaren yeni uygulamalar ve güncellemeler Android 16 (API 36) veya üstünü
# hedeflemek zorunda (Wear OS / Automotive: 35, TV / XR: 34). Uzatma süresi 1 Kasım 2026'da doldu.
# Google her yıl (genelde Ağustos) bu değeri yükseltir — yılda bir kontrol et.
LC_PLAY_MIN_TARGET_SDK=36
