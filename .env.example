# Launch Check — örnek ortam değişkenleri. Kopyala: cp .env.example .env

# --- Genel ---
LC_ENV=dev                                  # dev | prod (prod'da /api/docs kapalı)
LC_PUBLIC_BASE_URL=http://localhost:3000
LC_LOG_LEVEL=INFO
DOMAIN=localhost                            # Caddy bu alan adı için otomatik HTTPS alır

# --- Postgres ---
POSTGRES_USER=launchcheck
POSTGRES_PASSWORD=launchcheck               # prod'da MUTLAKA değiştir
POSTGRES_DB=launchcheck
LC_DATABASE_URL=postgresql+asyncpg://launchcheck:launchcheck@postgres:5432/launchcheck

# --- Redis ---
LC_REDIS_URL=redis://redis:6379/0

# --- Saklama ---
LC_REPORT_RETENTION_DAYS=7

# --- Rate limit (IP başına, saatlik). IP'ler tuzlanmış hash olarak, sadece Redis'te TTL ile tutulur ---
LC_RATE_LIMIT_WEB_PER_HOUR=10
LC_RATE_LIMIT_APK_PER_HOUR=3
LC_RATE_LIMIT_IP_SALT=change-me-to-a-long-random-string

# --- Web tarama ---
LC_BOT_USER_AGENT=LaunchCheckBot/1.0 (+https://launchcheck.example/bot)

# --- APK ---
LC_MAX_APK_BYTES=157286400                  # 150 MB
LC_SCAN_TMP_DIR=/tmp/launchcheck

# Google Play minimum targetSdkVersion.
# Kaynak: https://developer.android.com/google/play/requirements/target-sdk (doğrulama: 2026-11-05)
# 31 Ağustos 2026'dan itibaren yeni uygulamalar ve güncellemeler Android 16 (API 36) veya üstünü
# hedeflemek zorunda (Wear OS / Automotive: 35, TV / XR: 34). Uzatma süresi 1 Kasım 2026'da doldu.
# Google her yıl (genelde Ağustos) bu değeri yükseltir — yılda bir kontrol et.
LC_PLAY_MIN_TARGET_SDK=36

# --- Faz 2: derin tarama (docs/PHASE2.md §13) ---
# Aynı anda çalışan derin tarama sayısı (8 vCPU / 16 GB sunucu için 1; en fazla 2)
LC_DEEP_MAX_CONCURRENT=1
# Bekleyen derin tarama bunu aşarsa yeni istek "sıra dolu" ile reddedilir
LC_DEEP_QUEUE_MAX=10
# Sert sınır (sn). Dolarsa tarama elindekiyle tamamlanır.
LC_DEEP_SCAN_TIMEOUT_S=1200
LC_DEEP_MAX_PAGES=25
LC_DEEP_MAX_SUBDOMAINS=8
LC_DEEP_MAX_COMPETITORS=3
LC_DEEP_COMPETITOR_MAX_PAGES=6
# Şerit bütçeleri (sn); aşınca modül elindekiyle biter
LC_DEEP_BUDGET_BROWSER_S=420
LC_DEEP_BUDGET_LIGHTHOUSE_S=240
# Ağ şeridi: dış görünürlük (150) + linkler (120)
LC_DEEP_BUDGET_NETWORK_S=300
LC_DEEP_BUDGET_LLM_S=360
# Faz 1 raporu bundan eskiyse (saat) derin tarama başlatılamaz
LC_DEEP_PARENT_MAX_AGE_H=24
# IP başına günlük derin tarama (IP tuzlanmış hash olarak sadece Redis'te)
LC_RATE_LIMIT_DEEP_PER_DAY=3
# PageSpeed Insights / CrUX API anahtarı. Ücretsizdir: faturalandırma hesabı olmayan bir
# Google Cloud projesinde oluşturulur; kota dolarsa istek reddedilir, ücret çıkmaz.
# Boşsa hız modülü gerçek kullanıcı (saha) verisi olmadan çalışır.
# Kısıtlamalar: API restrictions → sadece "Chrome UX Report API"; Application restrictions →
# IP addresses (sunucunun IP'si). Anahtar sadece istek başlığında gider, loglanmaz.
LC_GOOGLE_API_KEY=
# --- Hız modülü (Lighthouse). Mobil ölçüm tekrarı (ortanca alınır) ve ölçüm başı süre sınırı
LC_DEEP_LIGHTHOUSE_RUNS=3
LC_DEEP_LIGHTHOUSE_DESKTOP_RUNS=1
LC_DEEP_LIGHTHOUSE_RUN_TIMEOUT_S=90
# (Lighthouse/Chromium geçici klasörü LC_SCAN_TMP_DIR altında; yol kısa olmalı: Unix soketi)
# Eşikler: Google Core Web Vitals sınırları (iyi / kötü), web.dev/articles/vitals
LC_DEEP_PERF_LCP_GOOD_MS=2500
LC_DEEP_PERF_LCP_POOR_MS=4000
LC_DEEP_PERF_CLS_GOOD=0.1
LC_DEEP_PERF_CLS_POOR=0.25
LC_DEEP_PERF_INP_GOOD_MS=200
LC_DEEP_PERF_INP_POOR_MS=500
# Boş ekran (ms), kullanılmayan JS oranı/miktarı, üçüncü taraf ağırlığı (bayt) ve ana thread (ms)
LC_DEEP_PERF_BLANK_SCREEN_MS=3000
LC_DEEP_PERF_UNUSED_JS_RATIO=0.5
LC_DEEP_PERF_UNUSED_JS_MIN_BYTES=204800
LC_DEEP_PERF_THIRD_PARTY_BYTES=512000
LC_DEEP_PERF_THIRD_PARTY_MAIN_THREAD_MS=1000
# --- Dış görünürlük modülü (crt.sh, DNS, Wayback, RDAP, sertifika) ---
# Modül bütçesi (sn) ve servis başına toplam istek süresi (Wayback büyük sitelerde ~60 sn)
LC_DEEP_BUDGET_EXTERNAL_S=150
LC_DEEP_EXTERNAL_TIMEOUTS_S={"crtsh":30,"certspotter":20,"wayback":60,"rdap":15,"youtube":10}
# Tüm taramalar için ortak istek sınırı (Redis): servis → [istek, pencere sn]. Servislere nazik
# davranmak için; sınır dolarsa o kontrol atlanır, tarama devam eder. Cert Spotter (crt.sh
# düşünce kullanılan yedek) kimliksiz kullanımda saatte 10 sorgu verir.
LC_DEEP_EXTERNAL_RATE_LIMITS={"crtsh":[10,60],"certspotter":[10,3600],"wayback":[15,60],"rdap":[30,60],"youtube":[120,60]}
# crt.sh'tan çıkan adlardan en fazla bu kadarının DNS'i çözülür; canlılardan en fazla
# LC_DEEP_MAX_SUBDOMAINS tanesine Faz 1 dosya/anahtar/HTTPS kontrolleri yapılır
LC_DEEP_SUBDOMAIN_MAX_CANDIDATES=60
LC_DEEP_SUBDOMAIN_SCAN_TIMEOUT_S=45
# Arşivde bulunan hassas yollardan şimdi en fazla bu kadarı denenir (sorgu dizesi olmadan)
LC_DEEP_WAYBACK_MAX_PROBES=15
# Alan adı / sertifika bitiş eşikleri (gün). Sertifika eşikleri ayrıca ömrün oranıyla sınırlanır
# (kısa ömürlü otomatik sertifikalar normal yenileme penceresinde alarm vermesin)
LC_DEEP_DOMAIN_EXPIRY_HIGH_DAYS=30
LC_DEEP_DOMAIN_EXPIRY_MEDIUM_DAYS=60
LC_DEEP_CERT_EXPIRY_HIGH_DAYS=14
LC_DEEP_CERT_EXPIRY_MEDIUM_DAYS=30
# --- Linkler, meta ve yapılandırılmış veri (P6) ---
# Tarayıcı şeridinde render'ın payı; kalan süre gizlilik modülüne (ve P7/P9'a) kalır
LC_DEEP_BUDGET_RENDER_S=270
LC_DEEP_BUDGET_LINKS_S=120
# Kontrol edilen en fazla iç / dış link. Aynı host'a iki istek arası en az bu kadar sn
# (hedefin kendisi için LC_DEEP_LINKS_OWN_HOST_INTERVAL_S)
LC_DEEP_LINKS_MAX_INTERNAL=100
LC_DEEP_LINKS_MAX_EXTERNAL=40
LC_DEEP_LINKS_PER_HOST_INTERVAL_S=1.0
LC_DEEP_LINKS_OWN_HOST_INTERVAL_S=0.25
LC_DEEP_YOUTUBE_MAX_VIDEOS=15
# og:image bu boyuttan büyükse (bayt) bazı uygulamalar önizlemede göstermeyebilir
LC_DEEP_OG_IMAGE_MAX_BYTES=5242880
# --- Gizlilik, tedarik zinciri, erişilebilirlik (P6) ---
LC_DEEP_BUDGET_PRIVACY_S=120
# Onay vermeden ve "Reddet"ten sonra ağ isteklerinin kaydedildiği süre (sn)
LC_DEEP_PRIVACY_OBSERVE_S=5
# İmaja gömülü veri dosyaları (yoksa ilgili kontrol atlanır). retire.js veritabanı worker-deep
# tarafından haftalık güncellenir ve LC_DEEP_RETIRE_UPDATE_DIR'e (tmpfs) yazılır.
LC_DEEP_TRACKER_LIST_PATH=/app/data/easyprivacy.txt
LC_DEEP_RETIRE_DB_PATH=/app/data/jsrepository.json
LC_DEEP_RETIRE_UPDATE_DIR=/tmp/launchcheck-data
LC_DEEP_AXE_PATH=/usr/local/lib/node_modules/axe-core/axe.min.js
# axe: ana sayfa + 4 kilit sayfa, mobil ve masaüstü
LC_DEEP_AXE_PAGES=5
# Yerel LLM (Ollama, sadece iç ağ). Model P8'de eval ile seçilir.
LC_LLM_BASE_URL=http://ollama:11434
LC_LLM_MODEL=
LC_LLM_TIMEOUT_S=150
LC_LLM_MAX_OUTPUT_TOKENS=900
LC_SCORE_WEIGHTS_DEEP={"security":0.4,"prod_readiness":0.2,"performance":0.15,"conversion":0.25}
# Rakip/örnek anatomisi ve ekran görüntüleri tüm kullanıcılar için bu kadar saat önbellekte
LC_BENCHMARK_CACHE_TTL_H=24
LC_ASSETS_DIR=/var/lib/launchcheck/assets
